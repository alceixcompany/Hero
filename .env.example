# npm run dev binds to all interfaces for two devices on the same Wi-Fi.
HOST=0.0.0.0
PORT=5173
ROOM_DATA_FILE=.data/rooms.json
# Public deployment: set the real HTTPS URL for invitation links.
# PUBLIC_URL=https://hero.example.com
# Optional exact browser origins, comma separated; default checks the request Host.
# ALLOWED_ORIGINS=https://hero.example.com

# Vercel static frontend build only: HTTPS origin of a running Node room server.
# NEXUS_ROOM_SERVER_URL=https://your-room-server.example.com
# Set ALLOWED_ORIGINS on that server to the exact frontend origin(s).
